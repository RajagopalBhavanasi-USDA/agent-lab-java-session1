{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "mvn: run",
			"type": "shell",
			"command": "$env:JAVA_HOME='C:\\softwaredistribution\\fpacdev\\java\\java-21-openjdk-21.0.7.0.6-1.win.jdk.x86_64'; $env:Path=($env:JAVA_HOME + '\\bin;' + $env:Path); cd socops; ./mvnw spring-boot:run",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "."
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Started.*Application.*",
					"endsPattern": "^.*Started.*Application.*in.*seconds.*"
				}
			},
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "mvn: build",
			"type": "shell",
			"command": "$env:JAVA_HOME='C:\\softwaredistribution\\fpacdev\\java\\java-21-openjdk-21.0.7.0.6-1.win.jdk.x86_64'; $env:Path=($env:JAVA_HOME + '\\bin;' + $env:Path); cd socops; ./mvnw clean package",
			"group": "build"
		},
		{
			"label": "mvn: test",
			"type": "shell",
			"command": "$env:JAVA_HOME='C:\\softwaredistribution\\fpacdev\\java\\java-21-openjdk-21.0.7.0.6-1.win.jdk.x86_64'; $env:Path=($env:JAVA_HOME + '\\bin;' + $env:Path); cd socops; ./mvnw test",
			"group": "test"
		}
	]
}